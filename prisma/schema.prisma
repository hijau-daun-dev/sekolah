// Prisma schema - Aplikasi Manajemen Sekolah (MI/MTs/SD/SMP)
// v2.0 - SCD Type 2, Soft Delete, Mapel per Tingkat, Ekstrakurikuler
// Konvensi: Int @id @default(autoincrement()), semua tabel punya sekolah_id

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ MASTER DATA SISTEM ============

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  label       String
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

// ============ MASTER DATA YAYASAN & JENJANG ============

model Yayasan {
  id          Int      @id @default(autoincrement())
  nama        String
  npsnYayasan String?  // NPSN Yayasan (jika ada)
  alamat      String?
  telepon     String?
  email       String?
  website     String?
  logoUrl     String?  // Logo yayasan (upload)
  ketuaYayasan String? // Nama ketua yayasan
  description String?
  statusAktif Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sekolahs    Sekolah[]
}

model Jenjang {
  id          Int      @id @default(autoincrement())
  kode        String   @unique // SD, MI, SMP, MTs, MA
  nama        String   // "Sekolah Dasar", "Madrasah Ibtidaiyah", dst
  urutan      Int      @default(0) // untuk ordering: SD/MI=1, SMP/MTs=2, MA=3
  keterangan  String?
  statusAktif Boolean  @default(true)
  createdAt   DateTime @default(now())

  sekolahs    Sekolah[]
}

model Sekolah {
  id            Int      @id @default(autoincrement())
  nama          String
  npsn          String?
  jenjang       String   @default("SD") // SD, SMP, MI, MTs, MA, SD-SMP, MI-MTs (legacy field, kept for backward compat)
  jenjangId     Int?     // FK to Jenjang (preferred)
  jenjangRef    Jenjang? @relation(fields: [jenjangId], references: [id])
  yayasan       String?  // Legacy: nama yayasan (kept for backward compat)
  yayasanId     Int?     // FK to Yayasan (preferred)
  yayasanRef    Yayasan? @relation(fields: [yayasanId], references: [id])
  alamat        String?
  logoUrl       String?
  telepon       String?
  email         String?
  website       String?
  kepalaSekolah String?
  nipKepala     String?
  description   String?
  statusAktif   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  siswas        Siswa[]
  pegawais      Pegawai[]
  ortus         Ortu[]
  tahunAjarans  TahunAjaran[]
  semesters     Semester[]
  tingkats      Tingkat[]
  jurusans      Jurusan[]
  kelases       Kelas[]
  kategoriMapels KategoriMapel[]
  mapels        Mapel[]
  komponenNilais KomponenNilai[]
  ruangans      Ruangan[]
  kategoriBarangs KategoriBarang[]
  barangs       Barang[]
  jenisPembayarans JenisPembayaran[]
  tarifPembayarans TarifPembayaran[]
  posAnggarans  PosAnggaran[]
  pengumumans   Pengumuman[]
  galeriBeritas GaleriBerita[]
  ekstrakurikulers Ekstrakurikuler[]
  riwayatKepalaSekolah RiwayatKepalaSekolah[]
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String
  roleId       Int
  role         Role     @relation(fields: [roleId], references: [id])
  sekolahId    Int?
  sekolah      Sekolah? @relation(fields: [sekolahId], references: [id])
  pegawaiId    Int?
  ortuId       Int?
  siswaId      Int?
  isActive     Boolean  @default(true)
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============ MASTER DATA PERSONALIA ============

model Siswa {
  id           Int      @id @default(autoincrement())
  sekolahId    Int
  sekolah      Sekolah  @relation(fields: [sekolahId], references: [id])
  nis          String?
  nisn         String?
  nama         String
  gender       String?
  tempatLahir  String?
  tanggalLahir DateTime?
  alamat       String?
  telepon      String?
  fotoUrl      String?
  status       String   @default("Aktif")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  kelasSiswas  KelasSiswa[]
  tagihans     TagihanSiswa[]
  absensis     AbsensiSiswa[]
  penilaians   Penilaian[]
  ortuSiswas   OrtuSiswa[]
  ekstrakurikulerSiswas EkstrakurikulerSiswa[]
}

model Pegawai {
  id           Int      @id @default(autoincrement())
  sekolahId    Int
  sekolah      Sekolah  @relation(fields: [sekolahId], references: [id])
  nip          String?
  nama         String
  gender       String?
  tempatLahir  String?
  tanggalLahir DateTime?
  alamat       String?
  telepon      String?
  email        String?
  jabatan      String?
  bidangStudi  String?
  fotoUrl      String?
  status       String   @default("Aktif")
  orgLevel     Int      @default(0)
  orgOrder     Int      @default(0)
  parentId     Int?
  parent       Pegawai? @relation("PegawaiOrg", fields: [parentId], references: [id], onDelete: SetNull)
  children     Pegawai[] @relation("PegawaiOrg")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  walikelas    Kelas[]
  jadwals      JadwalPelajaran[]
  absensiPegawai AbsensiPegawai[]
  guruMapels   GuruMapel[]
  peminjamanBarang PeminjamanBarang[]
  pembayarans  Pembayaran[]
  pengeluarans Pengeluaran[]
  pengumumans  Pengumuman[]
  ekstrakurikulers Ekstrakurikuler[]
  taKepalaSekolah TahunAjaran[] @relation("TAKepalaSekolah")
  penilaianInputs Penilaian[] @relation("PenilaianPenginput")
  riwayatKepalaSekolah RiwayatKepalaSekolah[] @relation("RiwayatKepalaSekolahPegawai")
}

model Ortu {
  id           Int      @id @default(autoincrement())
  sekolahId    Int
  sekolah      Sekolah  @relation(fields: [sekolahId], references: [id])
  nama         String
  nik          String?
  telepon      String?
  email        String?
  alamat       String?
  pekerjaan    String?
  fotoUrl      String?
  statusAktif  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  anakAnak     OrtuSiswa[]
}

model OrtuSiswa {
  id        Int   @id @default(autoincrement())
  ortuId    Int
  ortu      Ortu  @relation(fields: [ortuId], references: [id], onDelete: Cascade)
  siswaId   Int
  siswa     Siswa @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  hubungan  String

  @@unique([ortuId, siswaId])
}

// ============ MASTER DATA AKADEMIK ============

model TahunAjaran {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  nama        String
  tanggalMulai DateTime?
  tanggalSelesai DateTime?
  statusAktif Boolean  @default(false)
  kepalaSekolahPegawaiId Int?
  kepalaSekolahPegawai   Pegawai? @relation("TAKepalaSekolah", fields: [kepalaSekolahPegawaiId], references: [id], onDelete: SetNull)
  kepalaSekolahNama      String?
  createdAt   DateTime @default(now())

  semesters   Semester[]
  kelases     Kelas[]
  jadwals     JadwalPelajaran[]
  tagihans    TagihanSiswa[]
  tarifPembayarans TarifPembayaran[]
}

model Semester {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  tahunAjaranId Int
  tahunAjaran TahunAjaran @relation(fields: [tahunAjaranId], references: [id], onDelete: Cascade)
  nama        String
  statusAktif Boolean  @default(false)
  tanggalMulai DateTime?
  tanggalSelesai DateTime?
  penilaians  Penilaian[]
}

model Tingkat {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  nama        String
  jenjang     String?
  urutan      Int      @default(0)
  statusAktif Boolean  @default(true)
  kelases     Kelas[]
  tarifPembayarans TarifPembayaran[]
  tingkatMapels TingkatMapel[]
  guruMapels  GuruMapel[]
}

model Jurusan {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  kode        String
  nama        String
  keterangan  String?
  kelases     Kelas[]
}

model Kelas {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  nama        String
  tingkatId   Int
  tingkat     Tingkat  @relation(fields: [tingkatId], references: [id])
  jurusanId   Int?
  jurusan     Jurusan? @relation(fields: [jurusanId], references: [id])
  tahunAjaranId Int
  tahunAjaran TahunAjaran @relation(fields: [tahunAjaranId], references: [id])
  walikelasId Int?
  walikelas   Pegawai? @relation(fields: [walikelasId], references: [id], onDelete: SetNull)
  ruangan     String?
  kapasitas   Int?
  statusAktif Boolean  @default(true)
  createdAt   DateTime @default(now())

  kelasSiswas KelasSiswa[]
  jadwals     JadwalPelajaran[]
  absensis    AbsensiSiswa[]
}

model KelasSiswa {
  id          Int      @id @default(autoincrement())
  kelasId     Int
  kelas       Kelas    @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  siswaId     Int
  siswa       Siswa    @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  tahunAjaranId Int
  createdAt   DateTime @default(now())

  @@unique([kelasId, siswaId])
}

model KategoriMapel {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  nama        String
  keterangan  String?
  statusAktif Boolean  @default(true)
  mapels      Mapel[]
}

model Mapel {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  kode        String?
  nama        String
  kategoriMapelId Int?
  kategoriMapel KategoriMapel? @relation(fields: [kategoriMapelId], references: [id])
  jpPerMinggu Int?
  keterangan  String?
  statusAktif Boolean  @default(true)
  createdAt   DateTime @default(now())

  tingkatMapels TingkatMapel[]
  guruMapels  GuruMapel[]
  jadwals     JadwalPelajaran[]
  penilaians  Penilaian[]
}

// TingkatMapel: mapel per tingkat (bukan per kelas)
model TingkatMapel {
  id          Int      @id @default(autoincrement())
  tingkatId   Int
  tingkat     Tingkat  @relation(fields: [tingkatId], references: [id], onDelete: Restrict)
  mapelId     Int
  mapel       Mapel    @relation(fields: [mapelId], references: [id], onDelete: Restrict)
  jpPerMinggu Int?
  statusAktif Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([tingkatId, mapelId])
}

model KomponenNilai {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  nama        String
  bobot       Float    @default(0)
  keterangan  String?
  statusAktif Boolean  @default(true)
  penilaians  Penilaian[]
}

// GuruMapel: guru mengajar mapel di tingkat tertentu
model GuruMapel {
  id          Int      @id @default(autoincrement())
  pegawaiId   Int
  pegawai     Pegawai  @relation(fields: [pegawaiId], references: [id], onDelete: Restrict)
  mapelId     Int
  mapel       Mapel    @relation(fields: [mapelId], references: [id], onDelete: Restrict)
  tingkatId   Int
  tingkat     Tingkat  @relation(fields: [tingkatId], references: [id], onDelete: Restrict)
  statusAktif Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([pegawaiId, mapelId, tingkatId])
}

// ============ MASTER DATA SARANA ============

model Ruangan {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  kode        String?
  nama        String
  lokasi      String?
  kapasitas   Int?
  keterangan  String?
  statusAktif Boolean  @default(true)
  barangs     Barang[]
}

model KategoriBarang {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  nama        String
  keterangan  String?
  statusAktif Boolean  @default(true)
  barangs     Barang[]
}

model Barang {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  kode        String?
  nama        String
  kategoriBarangId Int?
  kategoriBarang KategoriBarang? @relation(fields: [kategoriBarangId], references: [id])
  ruanganId   Int?
  ruangan     Ruangan? @relation(fields: [ruanganId], references: [id])
  jumlah      Int      @default(1)
  kondisi     String   @default("Baik")
  status      String   @default("Tersedia")
  tanggalBeli DateTime?
  hargaBeli   Int?
  keterangan  String?
  statusAktif Boolean  @default(true)
  createdAt   DateTime @default(now())

  peminjamanBarang PeminjamanBarang[]
}

// ============ MASTER DATA KEUANGAN ============

model JenisPembayaran {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  nama        String
  keterangan  String?
  statusAktif Boolean  @default(true)
  tarifPembayarans TarifPembayaran[]
}

model TarifPembayaran {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  jenisPembayaranId Int
  jenisPembayaran JenisPembayaran @relation(fields: [jenisPembayaranId], references: [id])
  tahunAjaranId Int
  tahunAjaran TahunAjaran @relation(fields: [tahunAjaranId], references: [id])
  tingkatId   Int?
  tingkat     Tingkat? @relation(fields: [tingkatId], references: [id])
  nominal     Int
  frekuensi   String   @default("Bulanan")
  keterangan  String?
  statusAktif Boolean  @default(true)
  createdAt   DateTime @default(now())

  tagihans    TagihanSiswa[]
}

model PosAnggaran {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  kode        String?
  nama        String
  jenis       String   @default("Pengeluaran")
  keterangan  String?
  statusAktif Boolean  @default(true)
  pengeluarans Pengeluaran[]
}

// ============ TRANSAKSI AKADEMIK ============

model JadwalPelajaran {
  id            Int      @id @default(autoincrement())
  kelasId       Int?
  kelas         Kelas?   @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  mapelId       Int?
  mapel         Mapel?   @relation(fields: [mapelId], references: [id])
  pegawaiId     Int?
  pegawai       Pegawai? @relation(fields: [pegawaiId], references: [id])
  ekstrakurikulerId Int?
  tahunAjaranId Int
  tahunAjaran   TahunAjaran @relation(fields: [tahunAjaranId], references: [id])
  tipeJadwal    String   @default("pelajaran")
  judulKhusus   String?
  ekstrakurikuler Ekstrakurikuler? @relation(fields: [ekstrakurikulerId], references: [id], onDelete: SetNull)
  hari          String
  jamKe         Int
  jamMulai      String?
  jamSelesai    String?
  // SCD Type 2: snapshot nama guru & mapel saat jadwal dibuat
  pegawaiNamaSnapshot String?
  mapelNamaSnapshot   String?
  statusAktif   Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model AbsensiSiswa {
  id          Int      @id @default(autoincrement())
  siswaId     Int
  siswa       Siswa    @relation(fields: [siswaId], references: [id], onDelete: Restrict)
  kelasId     Int?
  kelas       Kelas?   @relation(fields: [kelasId], references: [id])
  tanggal     DateTime
  status      String
  keterangan  String?
  createdAt   DateTime @default(now())

  @@unique([siswaId, tanggal])
}

model Penilaian {
  id          Int      @id @default(autoincrement())
  siswaId     Int
  siswa       Siswa    @relation(fields: [siswaId], references: [id], onDelete: Restrict)
  mapelId     Int
  mapel       Mapel    @relation(fields: [mapelId], references: [id])
  komponenNilaiId Int
  komponenNilai KomponenNilai @relation(fields: [komponenNilaiId], references: [id])
  tahunAjaranId Int?
  semesterId  Int?
  semester    Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  // SCD Type 2: snapshot penginput nilai
  // Jika guru resign/pindah, nama guru yang input tetap tercatat
  penginputPegawaiId Int?
  penginputPegawai   Pegawai? @relation("PenilaianPenginput", fields: [penginputPegawaiId], references: [id], onDelete: SetNull)
  penginputNamaSnapshot String? // Nama guru saat input (snapshot, tidak berubah)
  nilai       Float
  tanggal     DateTime @default(now())
  keterangan  String?

  @@unique([siswaId, mapelId, komponenNilaiId, semesterId])
}

model AbsensiPegawai {
  id          Int      @id @default(autoincrement())
  pegawaiId   Int
  pegawai     Pegawai  @relation(fields: [pegawaiId], references: [id], onDelete: Restrict)
  tanggal     DateTime
  jamMasuk    DateTime?
  jamPulang   DateTime?
  status      String
  keterangan  String?
  createdAt   DateTime @default(now())

  @@unique([pegawaiId, tanggal])
}

// ============ TRANSAKSI KEUANGAN ============

model TagihanSiswa {
  id          Int      @id @default(autoincrement())
  siswaId     Int
  siswa       Siswa    @relation(fields: [siswaId], references: [id], onDelete: Restrict)
  tarifPembayaranId Int
  tarifPembayaran TarifPembayaran @relation(fields: [tarifPembayaranId], references: [id])
  tahunAjaranId Int
  tahunAjaran TahunAjaran @relation(fields: [tahunAjaranId], references: [id])
  bulanTagihan String?
  nominal     Int
  statusLunas Boolean  @default(false)
  tanggalJatuhTempo DateTime?
  createdAt   DateTime @default(now())

  pembayarans Pembayaran[]
}

model Pembayaran {
  id          Int      @id @default(autoincrement())
  tagihanSiswaId Int
  tagihanSiswa TagihanSiswa @relation(fields: [tagihanSiswaId], references: [id], onDelete: Cascade)
  pegawaiId   Int
  pegawai     Pegawai  @relation(fields: [pegawaiId], references: [id], onDelete: Restrict)
  tanggalBayar DateTime @default(now())
  jumlahBayar Int
  metodePembayaran String
  kodeKwitansi String   @unique
  keterangan  String?
  createdAt   DateTime @default(now())
}

model Pengeluaran {
  id          Int      @id @default(autoincrement())
  pegawaiId   Int
  pegawai     Pegawai  @relation(fields: [pegawaiId], references: [id], onDelete: Restrict)
  posAnggaranId Int
  posAnggaran PosAnggaran @relation(fields: [posAnggaranId], references: [id])
  tanggal     DateTime @default(now())
  nominal     Int
  keterangan  String
  buktiNotaUrl String?
  createdAt   DateTime @default(now())
}

// ============ TRANSAKSI SARANA ============

model PeminjamanBarang {
  id          Int      @id @default(autoincrement())
  barangId    Int
  barang      Barang   @relation(fields: [barangId], references: [id])
  peminjamPegawaiId Int?
  pegawai     Pegawai? @relation(fields: [peminjamPegawaiId], references: [id])
  tanggalPinjam DateTime @default(now())
  tanggalKembaliRencana DateTime
  tanggalKembaliAktual DateTime?
  kondisiKembali String?
  status      String   @default("Dipinjam")
  keterangan  String?
  createdAt   DateTime @default(now())
}

// ============ EKSTRAKURIKULER ============

model Ekstrakurikuler {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  nama        String
  deskripsi   String?
  pembinaId   Int?
  pembina     Pegawai? @relation(fields: [pembinaId], references: [id], onDelete: SetNull)
  hari        String?
  jamMulai    String?
  jamSelesai  String?
  tempat      String?
  statusAktif Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pesertas     EkstrakurikulerSiswa[]
  jadwals      JadwalPelajaran[]
}

model EkstrakurikulerSiswa {
  id                Int              @id @default(autoincrement())
  ekstrakurikulerId Int
  ekstrakurikuler   Ekstrakurikuler  @relation(fields: [ekstrakurikulerId], references: [id], onDelete: Cascade)
  siswaId           Int
  siswa             Siswa            @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  status            String           @default("Aktif")
  createdAt         DateTime         @default(now())

  @@unique([ekstrakurikulerId, siswaId])
}

// ============ TRANSAKSI KOMUNIKASI ============

model Pengumuman {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  pegawaiId   Int
  pegawai     Pegawai  @relation(fields: [pegawaiId], references: [id], onDelete: Restrict)
  judul       String
  isi         String
  target      String   @default("Semua")
  statusAktif Boolean  @default(true)
  tanggalPosting DateTime @default(now())
  createdAt   DateTime @default(now())
}

model GaleriBerita {
  id          Int      @id @default(autoincrement())
  sekolahId   Int
  sekolah     Sekolah  @relation(fields: [sekolahId], references: [id])
  judul       String
  konten      String
  gambarUrl   String?
  kategori    String?
  statusAktif Boolean  @default(true)
  tanggalPosting DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ============ RIWAYAT KEPALA SEKOLAH (SCD Type 2) ============

model RiwayatKepalaSekolah {
  id            Int      @id @default(autoincrement())
  sekolahId     Int
  sekolah       Sekolah  @relation(fields: [sekolahId], references: [id], onDelete: Cascade)
  pegawaiId     Int
  pegawai       Pegawai  @relation("RiwayatKepalaSekolahPegawai", fields: [pegawaiId], references: [id], onDelete: Restrict)
  namaSnapshot  String
  nipSnapshot   String?
  tanggalMulai  DateTime
  tanggalSelesai DateTime?
  status        String   @default("Aktif")
  keterangan    String?
  createdAt     DateTime @default(now())
}
